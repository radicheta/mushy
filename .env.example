# .env.example — copy to .env and fill in real values
# Required vars have no default; optional vars show their default in comments.

# ── TimescaleDB ───────────────────────────────────────────────────────────────
TIMESCALE_PASSWORD=changeme

# ── Mission Control (OpenMCT) ─────────────────────────────────────────────────
# CORS origins allowed by the bridge (comma-separated)
CORS_ORIGIN=http://localhost:8080

# ── FarmOS agent ─────────────────────────────────────────────────────────────
FARMOS_URL=http://10.68.155.50:8082
FARMOS_USERNAME=your_farmos_username
FARMOS_PASSWORD=your_farmos_password

# ── Alerter — Signal numbers (REQUIRED) ──────────────────────────────────────
# The Signal number registered on the 4G SIM (primary account on signal-cli).
# Format: E.164, e.g. +15551234567
SIGNAL_SENDER=+1XXXXXXXXXX

# The farmer's Signal number to receive alerts.
# Format: E.164, e.g. +15559876543
SIGNAL_RECIPIENT=+1XXXXXXXXXX

# ── Alerter — RH thresholds (optional — defaults shown) ──────────────────────
# RH setpoint (%). Must match fc_config.yaml target_humidity * 100 on fc1 Pi.
# WARNING: Changing this requires updating BOTH this file AND fc_config.yaml.
ALERT_RH_TARGET=90

# Alert band (±%). Wider than the controller band (±1%) by design.
# Alerter fires only when the system fails to stay within ±ALERT_RH_BAND%.
ALERT_RH_BAND=3

# Consecutive OOB samples required before firing a PROBLEM alert.
ALERT_OOB_N=5

# Minimum OOB window (minutes) before PROBLEM fires.
ALERT_OOB_WINDOW_MIN=3

# ── Alerter — cooldown cadences (optional — defaults shown) ──────────────────
# Minutes before a WARN alert can repeat.
ALERT_COOLDOWN_MIN=30

# Minutes before a CRITICAL alert can repeat.
ALERT_CRITICAL_COOLDOWN_MIN=60

# Minutes of Pi-offline before firing the Pi-offline PROBLEM alert.
ALERT_PI_OFFLINE_MIN=5

# Minutes humidifier has been ON with no RH rise before firing stuck alert.
ALERT_HUMIDIFIER_STUCK_MIN=30

# ── Alerter — heartbeat + receive loop (optional — defaults shown) ────────────
# Local hour (0-23) at which the daily heartbeat is sent (8 = 8 am farm time).
ALERT_HEARTBEAT_HOUR=8

# How often (seconds) the alerter polls signal-cli for incoming replies (snooze).
ALERT_RECEIVE_POLL_SEC=30

# ── Alerter — dashboard link (optional) ──────────────────────────────────────
# URL included in every alert message pointing to the farmer dashboard.
DASHBOARD_URL=http://elder-plops-ts:8081/farmer
