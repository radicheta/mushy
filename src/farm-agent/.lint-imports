# import-linter 2.11 config — Foray CI seam (FND-05)
#
# Primary gate (Phase 56): grep-in-pytest (tests/test_foray_seam.py).
# Secondary gate (Phase 63): this contract, activated when chamber/ lands.
#
# Run: lint-imports  (or: uv run lint-imports)
# Integrated into CI via: uv run lint-imports --config .lint-imports
#
# NOTE: chamber/ does not exist yet (added in Phase 63). The contract is
# inert until then — import-linter skips forbidden_modules that don't exist.
# Do NOT add import-linter to the pytest run until Phase 63.

[importlinter]
root_packages =
    farm_agent

[importlinter:contract:foray-seam]
name = Foray seam: no foray package imports from chamber
type = forbidden
source_modules =
    farm_agent.tenancy
    farm_agent.persistence
    farm_agent.extraction
    farm_agent.signal_io
    farm_agent.confirm
    farm_agent.farmos_client
    farm_agent.capture
    farm_agent.llm
forbidden_modules =
    farm_agent.chamber
