# import-linter 2.11 config — Foray CI seam (FND-05)
#
# Primary gate: grep-in-pytest (tests/test_foray_seam.py).
# Secondary gate: this contract. ACTIVATED in Phase 63 — it now runs inside the
# pytest suite via tests/test_import_linter_contract.py.
#
# Run: lint-imports  (or: uv run lint-imports)
#
# source_modules MUST list every real Foray package. import-linter hard-errors on
# an entry that does not resolve (unlike forbidden_modules, which may be absent).
# chamber/ is deliberately NOT a source module — it is the forbidden target, and it
# is free to import any Foray package (D-00).

[importlinter]
root_packages =
    farm_agent

[importlinter:contract:foray-seam]
name = Foray seam: no foray package imports from chamber
type = forbidden
source_modules =
    farm_agent.tenancy
    farm_agent.persistence
    farm_agent.extraction
    farm_agent.signal_io
    farm_agent.confirm
    farm_agent.farmos
    farm_agent.capture
    farm_agent.gate
forbidden_modules =
    farm_agent.chamber
