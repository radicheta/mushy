{
  "$ref": "#/definitions/Submission",
  "definitions": {
    "Submission": {
      "type": "object",
      "properties": {
        "drafts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "draft": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "seeding"
                      },
                      "species": {
                        "type": "string",
                        "minLength": 1
                      },
                      "block_name": {
                        "type": "string",
                        "pattern": "^[0-9]{6}_[A-Z]{2,4}_[0-9]+$"
                      },
                      "qty": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      },
                      "event_timestamp": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "parent_batch_name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "notes": {
                        "type": "string"
                      },
                      "confidence": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    },
                    "required": [
                      "type",
                      "species",
                      "block_name",
                      "qty",
                      "event_timestamp",
                      "confidence"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "activity"
                      },
                      "name": {
                        "type": "string",
                        "enum": [
                          "sterilize",
                          "sterilize_failed",
                          "water",
                          "relocate",
                          "cold_shock",
                          "archive_spent",
                          "contam"
                        ]
                      },
                      "asset_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "event_timestamp": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "notes": {
                        "type": "string"
                      },
                      "confidence": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    },
                    "required": [
                      "type",
                      "name",
                      "asset_ref",
                      "event_timestamp",
                      "confidence"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "input"
                      },
                      "recipe_lot": {
                        "type": "string",
                        "minLength": 1
                      },
                      "asset_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "event_timestamp": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "notes": {
                        "type": "string"
                      },
                      "confidence": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    },
                    "required": [
                      "type",
                      "recipe_lot",
                      "asset_ref",
                      "event_timestamp",
                      "confidence"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "observation"
                      },
                      "asset_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "state": {
                        "type": "string"
                      },
                      "notes": {
                        "type": "string"
                      },
                      "event_timestamp": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "confidence": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    },
                    "required": [
                      "type",
                      "asset_ref",
                      "event_timestamp",
                      "confidence"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "harvest"
                      },
                      "harvest_batch_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_block_refs": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1
                      },
                      "qty_g": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "event_timestamp": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "notes": {
                        "type": "string"
                      },
                      "confidence": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    },
                    "required": [
                      "type",
                      "harvest_batch_id",
                      "source_block_refs",
                      "qty_g",
                      "event_timestamp",
                      "confidence"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "seeding_session"
                      },
                      "event_date": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "groups": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "parent": {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "confidence": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 1
                                },
                                "sources": {
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "enum": [
                                      "audio",
                                      "paper_log_photo",
                                      "bag_label_photo",
                                      "text",
                                      "model_inference"
                                    ]
                                  },
                                  "minItems": 1
                                }
                              },
                              "required": [
                                "value",
                                "confidence",
                                "sources"
                              ],
                              "additionalProperties": false
                            },
                            "species": {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "string",
                                  "pattern": "^[A-Z]{2,4}$"
                                },
                                "confidence": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 1
                                },
                                "sources": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/definitions/Submission/properties/drafts/items/properties/draft/anyOf/5/properties/groups/items/properties/parent/properties/sources/items"
                                  },
                                  "minItems": 1
                                }
                              },
                              "required": [
                                "value",
                                "confidence",
                                "sources"
                              ],
                              "additionalProperties": false
                            },
                            "qty": {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0
                                },
                                "confidence": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 1
                                },
                                "sources": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/definitions/Submission/properties/drafts/items/properties/draft/anyOf/5/properties/groups/items/properties/parent/properties/sources/items"
                                  },
                                  "minItems": 1
                                }
                              },
                              "required": [
                                "value",
                                "confidence",
                                "sources"
                              ],
                              "additionalProperties": false
                            },
                            "child_block_names": {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "array",
                                  "items": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "const": "NEEDS_SEQ"
                                      },
                                      {
                                        "type": "string",
                                        "pattern": "^[0-9]{6}_[A-Z]{2,4}_[0-9]+$"
                                      }
                                    ]
                                  },
                                  "minItems": 1
                                },
                                "confidence": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 1
                                },
                                "sources": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/definitions/Submission/properties/drafts/items/properties/draft/anyOf/5/properties/groups/items/properties/parent/properties/sources/items"
                                  },
                                  "minItems": 1
                                }
                              },
                              "required": [
                                "value",
                                "confidence",
                                "sources"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "parent",
                            "species",
                            "qty",
                            "child_block_names"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1
                      },
                      "needs_input": {
                        "type": "string",
                        "enum": [
                          "starting_seq"
                        ]
                      },
                      "conflicts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "path": {
                              "type": "string",
                              "minLength": 1
                            },
                            "candidates": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "value": {},
                                  "source": {
                                    "$ref": "#/definitions/Submission/properties/drafts/items/properties/draft/anyOf/5/properties/groups/items/properties/parent/properties/sources/items"
                                  },
                                  "confidence": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1
                                  }
                                },
                                "required": [
                                  "source",
                                  "confidence"
                                ],
                                "additionalProperties": false
                              },
                              "minItems": 2
                            },
                            "resolution": {
                              "type": "string",
                              "enum": [
                                "photo_wins_implicit",
                                "ask_back_required",
                                "accepted_consensus"
                              ]
                            }
                          },
                          "required": [
                            "path",
                            "candidates",
                            "resolution"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "notes": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "event_date",
                      "groups"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "per_field_confidence": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "required": [
              "draft",
              "per_field_confidence"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "continuity": {
          "type": "string",
          "enum": [
            "append",
            "replace",
            "start_new"
          ]
        },
        "continuity_reason": {
          "type": "string",
          "minLength": 1
        },
        "capture_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "paper_log",
                "physical_object_photo",
                "voice_note",
                "text"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "drafts",
        "continuity",
        "continuity_reason"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}