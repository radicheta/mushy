<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="mushroom_incubator">
    <!-- Base link (incubator chamber) -->
    <link name="base_link">
      <visual name="visual">
        <geometry>
          <box>
            <size>1.0 0.8 1.5</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>1.0 0.8 1.5</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>16.67</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>16.67</iyy>
          <iyz>0.0</iyz>
          <izz>16.67</izz>
        </inertia>
      </inertial>
      <!-- Add thermal properties to the base_link -->
      <thermal_properties>
        <thermal_conductivity>0.024</thermal_conductivity>
        <specific_heat_capacity>1200.0</specific_heat_capacity>
        <density>50.0</density>
        <emissivity>0.9</emissivity>
        <temperature>293.15</temperature>
      </thermal_properties>
    </link>

    <!-- Heater element -->
    <link name="heater">
      <pose>0 0 -0.7 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.6 0.4 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.6 0.4 0.02</size>
          </box>
        </geometry>
      </collision>
      <thermal_properties>
        <thermal_conductivity>237.0</thermal_conductivity>
        <specific_heat_capacity>900.0</specific_heat_capacity>
        <density>2700.0</density>
        <emissivity>0.95</emissivity>
        <temperature>293.15</temperature>
      </thermal_properties>
    </link>

    <joint name="heater_joint" type="fixed">
      <parent>base_link</parent>
      <child>heater</child>
    </joint>

    <!-- Temperature sensor -->
    <link name="temp_sensor">
      <pose>0 0 0.5 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
      <sensor name="thermometer" type="thermal">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <thermal>
          <temperature>true</temperature>
        </thermal>
      </sensor>
    </link>

    <joint name="temp_sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>temp_sensor</child>
    </joint>

    <!-- Thermal source plugin for the heater -->
    <plugin
        filename="ignition-gazebo-thermal-source-system"
        name="ignition::gazebo::systems::ThermalSource">
      <link_name>heater</link_name>
      <power>500.0</power>
      <temperature_topic>/model/mushroom_incubator/heater/power</temperature_topic>
    </plugin>

    <!-- Thermal sensor plugin -->
    <plugin
        filename="ignition-gazebo-thermal-sensor-system"
        name="ignition::gazebo::systems::ThermalSensor">
      <link_name>temp_sensor</link_name>
      <topic>/model/mushroom_incubator/temperature</topic>
      <update_rate>10.0</update_rate>
    </plugin>
  </model>
</sdf>