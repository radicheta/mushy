<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="incubator_world">
    <!-- Include the ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Include the sun for lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Physics settings -->
    <physics type="ode">
      <real_time_update_rate>100</real_time_update_rate>
      <max_step_size>0.01</max_step_size>
    </physics>

    <!-- Ambient temperature -->
    <atmosphere type="adiabatic">
      <temperature>293.15</temperature>  <!-- 20°C in Kelvin -->
    </atmosphere>
  </world>
</sdf>
