<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="incubator_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://incubator</uri>
      <pose>0 0 0.75 0 0 0</pose>
      <name>mushroom_incubator</name>
    </include>
    <!-- World-level thermal properties -->
    <atmosphere type="adiabatic">
      <temperature>293.15</temperature>
      <pressure>101325</pressure>
    </atmosphere>

    <!-- Enable thermal system for the world -->
    <plugin
      filename="ignition-gazebo-thermodynamics-system"
      name="ignition::gazebo::systems::Thermodynamics">
    </plugin>
  </world>
</sdf>