# Mossrock tenant secrets — TEMPLATE (this .example IS committed).
# Copy to tenants/mossrock/secrets.env (gitignored by Plan-00 rule) and fill in
# the three values below. The alerter container loads secrets.env at boot;
# never commit the populated file.

# Anthropic API key for extractor + Haiku gate classifier (Phase 38 + Phase 44).
# Source: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# farmOS service-account password for write-path (Phase 40).
# Source: farmOS user 'farmos_agent' password (see FarmOS admin or [[farmos_project]]).
FARMOS_PASSWORD=

# Signal sender E.164 — bot account that *sends* messages.
# Source: signal-cli registered primary number on elder-plops 4G router SIM.
SIGNAL_SENDER=
