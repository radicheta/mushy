# Docker
.env
*.env
.docker

# Timescale data
timescale-data/

# Python
__pycache__/
*.pyc

# Misc
.DS_Store
.claude/

# Phase 17: agent node_modules
src/agents/*/node_modules/
src/agents/*/package-lock.json

# Mission Control: bridge + timelapse node_modules
src/mission-control/*/node_modules/
src/mission-control/*/package-lock.json

# Colcon build artifacts
build/
install/
log/

# Bridge runtime state (buffer-replay cursor)
bridge-state/
.planning/phases/32-vps-multi-purpose-hub/32-INVENTORY.md

# Phase 38 Plan 07 eval driver checkpoint state (base64-image-heavy, runtime only)
.planning/phases/38-extraction-pipeline/38-EVAL-REPORT.partial.json

# Phase 41 ingestion harness results JSONL (paid-run artifacts, operator-local)
src/agents/alerter/test/eval/ingestion/results/
# Phase 41 fixture test artifacts (placeholder PNGs / symlinks)
src/agents/alerter/test/eval/ingestion/test-fixtures/
# Phase 41 generated EVAL reports (per-run unique; canonical PASS gets committed manually)
.planning/phases/41-ingestion-harness/41-EVAL-REPORT-*.md

# Phase 44: tenant secrets (per D-11) — explicit override of *.env for auditability
tenants/*/secrets.env
tenants/*/.env
.venv/

# Claude Code auto-memory (symlinked from ~/.claude/projects/-mnt-slime-kingdom-opt-mushy/memory/)
# Lives in-tree for greppability but stays per-machine.
.planning/memory/

# Phase 54: per-run paid-LLM JSONL + summaries.log + receipts (operator-local).
# Canonical Cycle 1/2 attestation receipts are committed manually under
# .planning/phases/54-.../54-CYCLE-N-RECEIPT.md.
.planning/backfill/
# Same backfill scratch when the harness is run from the alerter cwd.
src/agents/alerter/.planning/backfill/

# Operator-local runtime logs (pinning cycler, smoke runs).
logs/

# MUSHY-59 control-law replay: cached Timescale CSV exports + pickle
# (operator-local, regenerated by scripts/replay-control-law.py).
.cache/

# MUSHY-35 — real credentials, supplied out-of-band, never committed.
# The netplan file is installed on fc1 by fc-system-sync.service, which is
# `if [ -f ]`-guarded: absent here means fc1 keeps its deployed copy untouched.
# Use 60-wifi.yaml.example as the shape reference.
client.ovpn
scripts/pi-deploy/etc/netplan/60-wifi.yaml

# MUSHY-142: per-run self-tune fit reports are products, not sources; the
# push script refuses to commit if the tree holds anything but the two files
# it writes, and a stray report would block every nightly commit.
# accepted.json is the pushed-state record and IS tracked.
reports/self-tune/*.json
!reports/self-tune/accepted.json
