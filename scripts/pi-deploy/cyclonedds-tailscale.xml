<?xml version="1.0" encoding="UTF-8"?>
<!-- CycloneDDS unicast config for ROS2 over Tailscale VPN (tailscale0) -->
<!-- PARKED 2026-05-03: not in active use; kept for when fc1 returns to farm-4G remote operation -->
<!-- Active config: scripts/pi-deploy/cyclonedds.xml (wg0, kernel-WG via pfSense) -->
<!-- Switching modes: see docs/pi-setup/tailscale-setup.md -->
<!-- Source: https://github.com/ros2/ros2_dds_profiles_examples/tree/main/cyclonedds -->
<!-- IMPORTANT: Only ONE <NetworkInterface> entry — multiple entries break unicast SPDP -->
<CycloneDDS xmlns="https://cdds.io/config"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
    <Domain Id="any">
        <General>
            <Interfaces>
                <NetworkInterface name="tailscale0" multicast="false" />
            </Interfaces>
            <AllowMulticast>false</AllowMulticast>
        </General>
        <Discovery>
            <LeaseDuration>5 s</LeaseDuration>
            <Peers>
                <Peer address="100.96.10.66"/>  <!-- elder-plops Tailscale IP -->
                <Peer address="100.96.239.75"/> <!-- FC-1 Pi Tailscale IP -->
            </Peers>
        </Discovery>
    </Domain>
</CycloneDDS>
