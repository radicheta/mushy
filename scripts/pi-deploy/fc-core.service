[Unit]
Description=FC-1 Mushroom Farm ROS2 Control
After=network-online.target fc-update.service tailscaled.service
Wants=network-online.target fc-update.service tailscaled.service

[Service]
Type=simple
User=ubuntu
Environment="ROS_DOMAIN_ID=69"
Environment="ROS_LOCALHOST_ONLY=0"
Environment="RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"
Environment="CYCLONEDDS_URI=file:///etc/cyclonedds-tailscale.xml"
Environment="HOME=/home/ubuntu"
ExecStartPre=/bin/bash -c '\
  echo "fc-core: waiting for tailscale0 interface..."; \
  for i in $(seq 1 30); do \
    if ip link show tailscale0 > /dev/null 2>&1; then \
      echo "fc-core: tailscale0 ready (attempt $i)"; \
      exit 0; \
    fi; \
    sleep 1; \
  done; \
  echo "fc-core: tailscale0 did not appear after 30s -- aborting start"; \
  exit 1'
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/ubuntu/mushroom_farm_ws/install/setup.bash && ros2 launch fc_core fc.launch.py'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
