[Unit]
Description=FC-1 Mushroom Farm ROS2 Control
After=network-online.target fc-update.service
Wants=network-online.target fc-update.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Environment="ROS_DOMAIN_ID=69"
Environment="ROS_LOCALHOST_ONLY=0"
Environment="RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"
Environment="CYCLONEDDS_URI=file:///etc/cyclonedds.xml"
Environment="HOME=/home/ubuntu"
ExecStartPre=/bin/bash -c 'install -d -o ubuntu -g ubuntu -m 0755 /var/lib/fc-core'
ExecStartPre=/bin/bash -c '\
  echo "fc-core: waiting for wg0 IPv4..."; \
  for i in $(seq 1 60); do \
    if ip -4 addr show wg0 2>/dev/null | grep -q "inet "; then \
      echo "fc-core: wg0 has IPv4 (attempt $i)"; \
      exit 0; \
    fi; \
    sleep 1; \
  done; \
  echo "fc-core: wg0 did not acquire IPv4 after 60s -- aborting start"; \
  exit 1'
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/ubuntu/mushroom_farm_ws/install/setup.bash && ros2 launch fc_core fc.launch.py'
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
